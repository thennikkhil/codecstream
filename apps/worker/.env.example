REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379
MONGODB_URI=
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional comma-separated languages for Amazon Transcribe.
TRANSCRIBE_LANGS=en-US,en-IN,hi-IN
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 32 random bytes, base64: openssl rand -base64 32  (must be identical in the API's .env)
KEY_ENCRYPTION_SECRET=
# Where the player lives. Baked into each video's playlist as the key URL.
PUBLIC_APP_URL=http://localhost:3000
